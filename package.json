{
  "name": "shohan-cv-studio",
  "productName": "SHOHAN CV STUDIO",
  "version": "1.1.0",
  "description": "SHOHAN CV STUDIO — professional offline Windows CV & resume builder (Windows 7 SP1 – 11), 30 premium A4 templates, DOCX/PDF export, direct A4 printing.",
  "author": {
    "name": "Shohan CV Studio",
    "email": "support@shohancvstudio.local"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/inject-csp.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "electron .",
    "desktop:dev": "cross-env SHOHAN_DEV_URL=http://localhost:5173 electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --ia32 --config electron-builder.config.cjs",
    "fonts": "node scripts/build-fonts.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "docs:previews": "npx vitest run tests/emit-models.test.ts && python3 scripts/render_previews.py",
    "audit": "bash scripts/feature-audit.sh",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:dist && npm run audit && npm run parity",
    "parity": "python3 scripts/doc-parity.py"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "@fontsource/lora": "5.1.1",
    "@fontsource/noto-sans-bengali": "5.1.1",
    "@fontsource/noto-serif-bengali": "5.1.1",
    "docx": "7.8.2",
    "fflate": "^0.8.2",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.8.0",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.7.0",
    "cross-env": "7.0.3",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "jsdom": "24.1.3",
    "typescript": "5.4.5",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=16 <23"
  }
}
